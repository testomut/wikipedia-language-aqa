# Copy to .env and fill in a dedicated Wikipedia test account.
# .env is git-ignored and docker-ignored: never commit real credentials.
WIKI_USERNAME=
WIKI_PASSWORD=

# Optional. Several accounts for parallel runs, one per worker (overrides WIKI_USERNAME / WIKI_PASSWORD):
# WIKI_USERS=[{"username":"user1","password":"..."},{"username":"user2","password":"..."}]

# Optional. Interface language to switch to (MediaWiki language code). Default: uk
TARGET_LANGUAGE=uk

# Optional. Default: https://en.wikipedia.org
WIKI_BASE_URL=

